rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdminRole(role) {
      return role in [
        'admin',
        'Admin',
        'ADMIN',
        'super_admin',
        'superadmin',
        'super admin',
        'super-admin',
        'Super Admin',
        'SUPER ADMIN',
        'SUPER_ADMIN',
        'Super_Admin',
      ];
    }

    function isAdmin() {
      return isSignedIn() && isAdminRole(userDoc(currentUid()).data.role);
    }

    // PHONE NUMBERS collection for uniqueness checking
    match /phoneNumbers/{phoneNumber} {
      allow read: if true; // Allow anyone to check phone number availability
      allow create: if isSignedIn() && phoneNumber == request.resource.data.phoneNumber;
      allow update: if isSignedIn() && phoneNumber == request.resource.data.phoneNumber;
      allow delete: if isSignedIn() && phoneNumber == resource.data.phoneNumber;
    }

    // USERNAME availability checking
    match /usernames/{username} {
      allow read: if true; // Allow anyone to check username availability
      allow create: if isSignedIn() && username == request.resource.data.username;
      allow update: if isSignedIn() && username == request.resource.data.username;
      allow delete: if isSignedIn() && username == resource.data.username;
    }

    // USERS
    match /users/{uid} {
      allow create: if isSignedIn()
        && uid == currentUid()
        && request.resource.data.role == 'user';

      // Allow reading user data for trust badges, public profile info, and password reset
      // Anyone can read to check if phone/email exists (needed for forgot password)
      allow read: if true;

      allow update: if isSignedIn() && uid == currentUid()
        && !request.resource.data.diff(resource.data)
            .changedKeys()
            .hasAny(['role','totalAdsPosted','activeAdsCount','rejectedAdsCount','updatedBy','createdAt'])
        || isAdmin();

      allow delete: if isAdmin();

      // Saved Ads subcollection (users/{uid}/savedAds/{adId})
      match /savedAds/{adId} {
        // Users can read their own saved ads
        allow read: if isSignedIn() && uid == currentUid();
        
        // Users can save ads (create bookmark)
        allow create: if isSignedIn() && uid == currentUid();
        
        // Users can delete their own saved ads (remove bookmark)
        allow delete: if isSignedIn() && uid == currentUid();
        
        // No updates needed
        allow update: if false;
      }

      // User-scoped inspection reports/drafts
      match /inspections/{inspectionId} {
        allow read, create, update, delete: if isSignedIn() && uid == currentUid();
      }
    }

    // ADS - SIMPLIFIED RULES
    match /ads/{adId} {
      // Anyone can create their own ad (if signed in)
      // Allow 'pending' status for manual review OR 'active' status for verified ads
      allow create: if isSignedIn()
        && request.resource.data.userId == currentUid()
        && (
          request.resource.data.status == 'pending' ||
          (
            request.resource.data.status == 'active' &&
            request.resource.data.isVerified == true &&
            request.resource.data.verifiedAt is timestamp &&
            request.resource.data.vehicleVerification is map
          )
        );

      // SIMPLIFIED: Allow reading ALL ads for everyone (your app filters in memory)
      allow read: if true;

      // Updates: owners can edit their own ads with controlled status transitions; admins can do anything.
      allow update: if isSignedIn() && (
        (
          resource.data.userId == currentUid() && (
            // SOLD: only status and previousStatus (optional clear)
            (
              request.resource.data.status == 'sold' &&
              request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','previousStatus','soldAt']) &&
              request.resource.data.soldAt is timestamp &&
              (!('previousStatus' in request.resource.data) || request.resource.data.previousStatus == null)
            ) ||
            // REMOVED: may set previousStatus (string)
            (
              request.resource.data.status == 'removed' &&
              request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','previousStatus','expiredAt','expirationReason']) &&
              (!('expiredAt' in request.resource.data) || request.resource.data.expiredAt is timestamp) &&
              (!('expirationReason' in request.resource.data) || request.resource.data.expirationReason is string) &&
              (request.resource.data.previousStatus is string)
            ) ||
            // REACTIVATE from removed: restore status to active/pending and clear previousStatus
            (
              resource.data.status == 'removed' &&
              request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','previousStatus','expiresAt']) &&
              request.resource.data.status in ['active','pending'] &&
              request.resource.data.expiresAt is timestamp &&
              request.resource.data.previousStatus == null
            ) ||
            // Other updates: cannot touch status, previousStatus, moderation fields
            (
              !request.resource.data.diff(resource.data)
                .changedKeys()
                .hasAny(['status','previousStatus','approvedAt','approvedBy','rejectedAt','rejectedBy','rejectionReason'])
            )
          )
        ) || isAdmin()
      );

      // Deletes: owners can delete their own ads; admins can delete any ad
      allow delete: if isSignedIn() && (
        resource.data.userId == currentUid() || isAdmin()
      );

      // Insights subcollection for ad analytics
      match /insights/{document=**} {
        // Anyone can read insights for public ads
        allow read: if true;
        
        // Anyone signed in can write to insights (views, saves, contacts, messages tracking)
        // This allows tracking analytics from any user viewing/interacting with ads
        allow write: if isSignedIn();
      }
    }

    // MARKETPULSE aggregate cache
    match /marketpulse_cache/{cacheId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // MARKETPULSE analytics tracking
    match /analytics_views/{eventId} {
      allow read: if isSignedIn();
      allow create: if
        request.resource.data.adId is string &&
        request.resource.data.eventType in ['view', 'click'] &&
        request.resource.data.timestamp is timestamp &&
        (
          (!('userId' in request.resource.data) || request.resource.data.userId == null) ||
          (isSignedIn() && request.resource.data.userId == currentUid())
        );
      allow update, delete: if isAdmin();
    }

    match /analytics_searches/{eventId} {
      allow read: if isSignedIn();
      allow create: if
        request.resource.data.query is string &&
        request.resource.data.timestamp is timestamp &&
        (
          (!('userId' in request.resource.data) || request.resource.data.userId == null) ||
          (isSignedIn() && request.resource.data.userId == currentUid())
        );
      allow update, delete: if isAdmin();
    }

    match /search_logs/{eventId} {
      allow read: if isSignedIn();
      allow create: if
        request.resource.data.query is string &&
        request.resource.data.timestamp is timestamp &&
        (
          (!('userId' in request.resource.data) || request.resource.data.userId == null) ||
          (isSignedIn() && request.resource.data.userId == currentUid())
        );
      allow update, delete: if isAdmin();
    }

    match /analytics_filters/{eventId} {
      allow read: if isSignedIn();
      allow create: if
        request.resource.data.filterType is string &&
        request.resource.data.value is string &&
        request.resource.data.timestamp is timestamp &&
        (
          (!('userId' in request.resource.data) || request.resource.data.userId == null) ||
          (isSignedIn() && request.resource.data.userId == currentUid())
        );
      allow update, delete: if isAdmin();
    }

    match /analytics_deals/{eventId} {
      allow read: if isSignedIn();
      allow create: if
        request.resource.data.adId is string &&
        request.resource.data.price is number &&
        request.resource.data.timestamp is timestamp &&
        (
          (!('userId' in request.resource.data) || request.resource.data.userId == null) ||
          (isSignedIn() && request.resource.data.userId == currentUid())
        );
      allow update, delete: if isAdmin();
    }

    match /ad_promotions/{promotionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.userId == currentUid()
        && request.resource.data.adId is string
        && request.resource.data.amount is number
        && request.resource.data.packageId is string
        && request.resource.data.timestamp is timestamp;
      allow update, delete: if isAdmin();
    }

    // REVIEWS collection (separate collection)
    match /reviews/{reviewId} {
      // Allow reading all reviews
      allow read: if true;

      // Allow creating reviews only if:
      allow create: if isSignedIn()
        && request.resource.data.userId == currentUid()
        && request.resource.data.adId is string
        && request.resource.data.adTitle is string
        && request.resource.data.adOwnerId is string
        && request.resource.data.userName is string
        && request.resource.data.comment is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt is timestamp
        && request.resource.data.adOwnerId != currentUid();

      // Allow users to update their own reviews (only comment and rating)
      allow update: if isSignedIn() 
        && resource.data.userId == currentUid()
        && request.resource.data.userId == currentUid()
        && request.resource.data.adId == resource.data.adId
        && request.resource.data.adTitle == resource.data.adTitle
        && request.resource.data.adOwnerId == resource.data.adOwnerId
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.comment is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      // Allow users to delete their own reviews
      allow delete: if isSignedIn() && resource.data.userId == currentUid();

      // Admins can do anything with reviews
      allow write: if isAdmin();
    }

    // ACTIVITIES (audit log)
    match /activities/{activityId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // BLOG POSTS collection
    match /blog_posts/{postId} {
      // Anyone can read blog posts (app filters by isPublished)
      allow read: if true;
      
      // Only admins can create, update, or delete blog posts
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // VIDEOS collection
    match /videos/{videoId} {
      // Anyone can read videos (app filters by isPublished)
      allow read: if true;
      
      // Only admins can create, update, or delete videos
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // BLOGS collection (new addition for our implementation)
    match /blogs/{blogId} {
      // Allow everyone to read blogs (public content)
      allow read: if true;
      // Only admins can create, update, and delete blogs
      allow create, update, delete: if isAdmin();
    }

    // ANNOUNCEMENT BANNERS collection
    match /announcement_banners/{bannerId} {
      // Everyone can read announcement banners used on the public home page
      allow read: if true;
      // Only admins can create, update, and delete banners
      allow create, update, delete: if isAdmin();
    }

    // FUEL PRICES collection
    match /fuel_prices/{fuelId} {
      // Home screen reads are public
      allow read: if true;
      // Only admins can manage prices
      allow create, update, delete: if isAdmin();
    }

    // CONVERSATIONS collection for chat
    match /conversations/{conversationId} {
      // Helper function to check if user is a participant
      function isParticipant() {
        return isSignedIn() && (
          (resource != null && resource.data.participant1Id == currentUid()) ||
          (resource != null && resource.data.participant2Id == currentUid())
        );
      }

      // Helper function to check if user will be a participant (for create)
      function willBeParticipant() {
        return isSignedIn() && (
          request.resource.data.participant1Id == currentUid() ||
          request.resource.data.participant2Id == currentUid()
        );
      }

      // Users can read conversations they are part of
      // Also allow read if document doesn't exist (for existence check before creation)
      allow read: if isSignedIn() && (
        (resource != null && (
          resource.data.participant1Id == currentUid() ||
          resource.data.participant2Id == currentUid()
        )) ||
        !exists(/databases/$(database)/documents/conversations/$(conversationId))
      );

      // Users can create conversations they are part of
      allow create: if willBeParticipant();

      // Users can update conversations they are part of (for last message, unread counts)
      allow update: if isParticipant();

      // Messages subcollection
      match /messages/{messageId} {
        // Helper function to get conversation data safely
        function getConversationData() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        // Helper function to check if user is participant in parent conversation
        function isConversationParticipant() {
          return isSignedIn() && (
            getConversationData().participant1Id == currentUid() ||
            getConversationData().participant2Id == currentUid()
          );
        }

        // Users can read messages in conversations they are part of
        allow read: if isConversationParticipant();

        // Users can create messages where they are the sender
        allow create: if isSignedIn() && 
          request.resource.data.senderId == currentUid() &&
          isConversationParticipant();

        // Users can update messages:
        // 1. If they are the sender (to mark as delivered)
        // 2. If they are the receiver (to mark as read)
        allow update: if isSignedIn() && isConversationParticipant() && (
          // Sender can update their own messages (to mark as delivered)
          (resource.data.senderId == currentUid() && 
           request.resource.data.diff(resource.data).changedKeys().hasOnly(['status'])) ||
          // Receiver can update messages they received (to mark as read)
          (resource.data.receiverId == currentUid() && 
           (request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'isRead']) ||
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead'])))
        );

        // Users can delete messages in conversations they are part of
        // This allows deletion for all users (not just sender)
        allow delete: if isSignedIn() && isConversationParticipant();
      }
    }

    // INSPECTIONS (root-level collection for saved inspection reports)
    match /inspections/{inspectionId} {
      // Allow signed-in users to read their own saved reports and admins to read all
      allow read: if isSignedIn();

      // Create: any signed-in user can save an inspection report to the root collection
      allow create: if isSignedIn() && request.resource.data.userId == currentUid();

      // Update/Delete: owners or admins
      allow update, delete: if isSignedIn() && (
        resource.data.userId == currentUid() || isAdmin()
      );
    }

    // INVESTMENT VEHICLES collection
    match /investment_vehicles/{vehicleId} {
      // Anyone can read investment vehicles (public content)
      allow read: if true;
      
      // Users can create investment vehicles they initiate
      allow create: if isSignedIn() 
        && request.resource.data.initiatorUserId == currentUid();
      
      // Update rules:
      // 1. Initiator or admin can update any field
      // 2. Any authenticated user can update currentInvestment and updatedAt (for investments)
      allow update: if isSignedIn() && (
        // Initiator or admin can update anything
        resource.data.initiatorUserId == currentUid() || isAdmin() ||
        // Any user can update currentInvestment and updatedAt when making an investment
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentInvestment', 'updatedAt']) ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentInvestment']) ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']))
      );
      
      // Only admin can delete
      allow delete: if isAdmin();
    }

    // INVESTMENTS collection
    match /investments/{investmentId} {
      // Anyone can read investments (for transparency)
      allow read: if true;
      
      // Users can create investments for themselves
      allow create: if isSignedIn() 
        && request.resource.data.userId == currentUid();
      
      // Users can update their own investments (for share sale listings)
      // System can update investment status and profit
      allow update: if isSignedIn() && (
        resource.data.userId == currentUid() || isAdmin()
      );
      
      // Only admin can delete
      allow delete: if isAdmin();
    }

    // INVESTMENT TRANSACTIONS collection
    match /investment_transactions/{transactionId} {
      // Users can read their own transactions
      allow read: if isSignedIn() && resource.data.userId == currentUid();
      
      // Users can create transactions for themselves
      allow create: if isSignedIn() 
        && request.resource.data.userId == currentUid();
      
      // Users can update their own transactions (for payment status)
      // System can update transaction status
      allow update: if isSignedIn() && (
        resource.data.userId == currentUid() || isAdmin()
      );
      
      // Only admin can delete
      allow delete: if isAdmin();
    }

    // SHARE MARKETPLACE collection
    match /share_marketplace/{listingId} {
      // Anyone signed in can read active listings
      allow read: if isSignedIn();
      
      // Users can create listings for their own investments
      allow create: if isSignedIn() 
        && request.resource.data.sellerUserId == currentUid();
      
      // Sellers can update their own listings
      allow update: if isSignedIn() && (
        resource.data.sellerUserId == currentUid() || isAdmin()
      );
      
      // Sellers can delete their own listings, admins can delete any
      allow delete: if isSignedIn() && (
        resource.data.sellerUserId == currentUid() || isAdmin()
      );
    }

    // INVESTMENT NOTIFICATIONS collection
    match /investment_notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isSignedIn() && resource.data.userId == currentUid();
      
      // System can create notifications (users can't create their own)
      // In production, this should be done via Cloud Functions
      allow create: if isSignedIn();
      
      // Users can update their own notifications (to mark as read)
      allow update: if isSignedIn() && 
        resource.data.userId == currentUid() &&
        request.resource.data.diff(resource.data)
          .changedKeys()
          .hasOnly(['read']);
      
      // Users can delete their own notifications, admins can delete any
      allow delete: if isSignedIn() && (
        resource.data.userId == currentUid() || isAdmin()
      );
    }

    // VISIT SCHEDULES collection
    match /visitSchedules/{scheduleId} {
      // Book Visit screen reads city/area/date/slot data from here
      allow read: if true;

      // Only admins can manage schedules
      allow create, update, delete: if isAdmin();
    }

    // VISITS collection
    match /visits/{visitId} {
      // Users can read their own visits, admins can read all
      allow read: if isSignedIn() && (
        resource.data.userId == currentUid() || isAdmin()
      );

      // Users can create their own visit booking records
      allow create: if isSignedIn()
        && request.resource.data.userId == currentUid()
        && request.resource.data.city is string
        && request.resource.data.area is string
        && request.resource.data.date is timestamp
        && request.resource.data.dateKey is string
        && request.resource.data.timeSlot is string
        && request.resource.data.paymentMethod is string
        && request.resource.data.amount is number
        && request.resource.data.status == 'booked';

      // Owners can only update reschedule-request metadata on their own visits.
      // Admins can update anything (accept/reject requests, move booking, mark complete).
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.userId == currentUid()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.city == resource.data.city
          && request.resource.data.area == resource.data.area
          && request.resource.data.date == resource.data.date
          && request.resource.data.dateKey == resource.data.dateKey
          && request.resource.data.timeSlot == resource.data.timeSlot
          && request.resource.data.paymentMethod == resource.data.paymentMethod
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'rescheduleStatus',
            'pendingRescheduleRequestId',
            'requestedRescheduleDate',
            'requestedRescheduleDateKey',
            'requestedRescheduleTimeSlot',
            'updatedAt'
          ])
        )
      );

      // Only admins can delete visit records
      allow delete: if isAdmin();
    }

    // RESCHEDULE REQUESTS collection
    match /rescheduleRequests/{requestId} {
      // Users can read their own requests, admins can read all
      allow read: if isSignedIn() && (
        resource.data.userId == currentUid() || isAdmin()
      );

      // Users can create reschedule requests for themselves
      allow create: if isSignedIn()
        && request.resource.data.userId == currentUid()
        && request.resource.data.visitId is string
        && request.resource.data.requestedDate is timestamp
        && request.resource.data.requestedDateKey is string
        && request.resource.data.requestedTimeSlot is string
        && request.resource.data.status == 'pending';

      // Admin reviews requests by changing status to accepted/rejected
      allow update: if isAdmin();

      // Admin can remove requests if needed
      allow delete: if isAdmin();
    }

    // VISIT NOTIFICATIONS collection
    match /visitNotifications/{notificationId} {
      // Users can read their own notifications, admins can read all
      allow read: if isSignedIn() && (
        resource.data.userId == currentUid() || isAdmin()
      );

      // Admin actions create notifications for users
      allow create: if isAdmin()
        && request.resource.data.userId is string
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.message is string;

      // Users can update only lightweight notification state on their own docs
      allow update: if isSignedIn()
        && resource.data.userId == currentUid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'readAt'
        ]);

      // Users can delete their own notifications, admins can delete any
      allow delete: if isSignedIn() && (
        resource.data.userId == currentUid() || isAdmin()
      );
    }

    // LIVE SUPPORT CHAT
    match /supportChats/{userId} {
      // Users can access their own support ticket; admins can access all tickets.
      allow read: if isSignedIn() && (userId == currentUid() || isAdmin());

      // Users create/update their own support ticket metadata.
      // Admins update tickets when replying, reading, or resolving.
      allow create, update: if isSignedIn() && (
        userId == currentUid() || isAdmin()
      );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          userId == currentUid() || isAdmin()
        );

        allow create: if isSignedIn() && (
          (
            userId == currentUid()
            && request.resource.data.senderId == currentUid()
            && request.resource.data.senderType == 'user'
            && request.resource.data.text is string
            && request.resource.data.timestamp is timestamp
            && request.resource.data.isRead is bool
          ) ||
          (
            isAdmin()
            && request.resource.data.senderId == currentUid()
            && request.resource.data.senderType == 'admin'
            && request.resource.data.text is string
            && request.resource.data.timestamp is timestamp
            && request.resource.data.isRead is bool
          )
        );

        // Users/admins may only toggle isRead on messages they received.
        allow update: if isSignedIn() && (
          (
            userId == currentUid()
            && resource.data.senderType == 'admin'
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead'])
          ) ||
          (
            isAdmin()
            && resource.data.senderType == 'user'
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead'])
          )
        );

        allow delete: if isSignedIn() && (
          userId == currentUid() || isAdmin()
        );
      }
    }

    // SUPPORT QUICK REPLIES: admin-managed instant answers before live chat
    match /supportQuickReplies/{topicId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /questions/{questionId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // SUPPORT CONFIG: online status and ticket counter
    match /config/{configId} {
      allow read: if configId == 'supportStatus' || configId == 'ticketCounter';

      // Admin panel writes online/away state.
      allow create, update: if configId == 'supportStatus' && isAdmin();

      // Users may increment ticket counter when creating support tickets.
      // The client uses a Firestore transaction to avoid race conditions.
      allow create, update: if configId == 'ticketCounter' && isSignedIn();

      allow delete: if isAdmin();
    }

    // Optional notification queue used when the callable FCM function is unavailable.
    match /support_notification_requests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.body is string;
    }

    // Deny everything else - KEEP THIS AT THE END
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
